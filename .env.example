# --- App ---
APP_NAME=AlphaForge
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
TRADING_MODE=paper
BROKER_ADAPTER=paper
DATA_ADAPTER=yfinance
STRATEGY_SYMBOLS=RELIANCE.NS,INFY.NS,HDFCBANK.NS
LOG_LEVEL=INFO

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
MASTER_KEY=change-me-fernet-compatible-or-raw-secret
API_KEY=change-me-internal-service-key

# --- Database ---
DATABASE_URL=postgresql+asyncpg://alphaforge:alphaforge@localhost:5432/alphaforge
REDIS_URL=redis://localhost:6379/0

# --- Operator (bootstrap) ---
OPERATOR_EMAIL=operator@localhost
OPERATOR_PASSWORD=change-me

# --- Brokers (leave empty for local paper broker) ---
# Angel One SmartAPI — data can be used in paper; orders only when TRADING_MODE=live
# and BROKER_ADAPTER=angelone. Create keys at https://smartapi.angelone.in
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
ANGEL_PRODUCT=DELIVERY

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Market data ---
POLYGON_API_KEY=

# --- Risk gates ---
MAX_DAILY_LOSS_PCT=2.0
MAX_DRAWDOWN_PCT=10.0
MAX_GROSS_EXPOSURE_PCT=100.0
MAX_POSITION_PCT=20.0
MAX_ORDERS_PER_DAY=50
KILL_SWITCH_ENABLED=false

# --- Alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Frontend & CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

